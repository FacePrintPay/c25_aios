GET    /api/v1/sessions                 // List all sessions
GET    /api/v1/sessions/live            // Live sessions now
GET    /api/v1/sessions/scheduled       // Scheduled sessions
POST   /api/v1/sessions/schedule        // Schedule new hearing
POST   /api/v1/sessions/:id/start       // Start session
POST   /api/v1/sessions/:id/end         // End session
GET    /api/v1/sessions/:id/token       // Get WebRTC token
POST   /api/v1/sessions/:id/invite      // Invite participants