#!/data/data/com.termux/files/usr/bin/env bash
# C25 SYSTEM.SKILLS - Master Skill Registry
# Aggregates all agent.sh scripts, Termux history, and file system capabilities

set -euo pipefail

export C25_ROOT="${C25_ROOT:-$HOME/dist-canonical}"
export SKILLS_DIR="$C25_ROOT/skills"
export AGENTS_DIR="$C25_ROOT/agents"
export HISTORY_FILE="${HISTFILE:-$HOME/.bash_history}"
export TERMUX_API="/data/data/com.termux/files/usr/bin"

# Color codes
RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; YELLOW='\033[1;33m'; NC='\033[0m'

log() { echo -e "${CYAN}[SKILLS]${NC} $1"; }
ok() { echo -e "${GREEN}[✓]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err() { echo -e "${RED}[✗]${NC} $1"; exit 1; }

# Initialize skill registry
init_registry() {
    mkdir -p "$SKILLS_DIR" "$AGENTS_DIR"
    cat > "$SKILLS_DIR/registry.json" << 'EOF'
{
  "version": "1.0.0",
  "updated": "$(date -Iseconds)",
  "agents": [],
  "skills": [],
  "history_sources": [],
  "file_patterns": [".sh", ".md", ".json", ".go", ".fastapi", ".mht"]
}
EOF
    log "Initialized skill registry at $SKILLS_DIR/registry.json"
}

# Scan Termux history for commands
scan_termux_history() {
    log "Scanning Termux history..."
    local cmds=()
    
    if [[ -f "$HISTORY_FILE" ]]; then
        while IFS= read -r line; do
            [[ -z "$line" || "$line" =~ ^# ]] && continue
            cmds+=("$line")
        done < "$HISTORY_FILE"
        
        # Extract unique command patterns
        printf '%s\n' "${cmds[@]}" | sort -u | head -100 > "$SKILLS_DIR/history_commands.txt"
        ok "Extracted $(wc -l < "$SKILLS_DIR/history_commands.txt") unique commands from history"
    else
        warn "No bash history found at $HISTORY_FILE"
        touch "$SKILLS_DIR/history_commands.txt"
    fi
    
    # Termux API specific commands
    if command -v termux-api &>/dev/null; then
        log "Scanning Termux API capabilities..."
        termux-battery-status &>/dev/null && echo "termux-battery-status" >> "$SKILLS_DIR/history_commands.txt"
        termux-notification --title "test" --content "test" &>/dev/null && echo "termux-notification" >> "$SKILLS_DIR/history_commands.txt"
        termux-location &>/dev/null && echo "termux-location" >> "$SKILLS_DIR/history_commands.txt"
        termux-sensor -l &>/dev/null && echo "termux-sensor" >> "$SKILLS_DIR/history_commands.txt"
        ok "Termux API skills detected"
    fi
}

# Use ranger to list all files if available
scan_with_ranger() {
    log "Attempting ranger file discovery..."
    
    if command -v ranger &>/dev/null; then
        # Ranger doesn't have direct CLI output, simulate with find
        find "$C25_ROOT" -type f \( -name "*.sh" -o -name "*.md" -o -name "*.json" -o -name "*.go" -o -name "*.fastapi" -o -name "*.mht" \) 2>/dev/null | \
        sort > "$SKILLS_DIR/ranger_files.txt"
        ok "Found $(wc -l < "$SKILLS_DIR/ranger_files.txt") files via ranger-compatible scan"
    else
        warn "ranger not installed, using native find"
        find "$C25_ROOT" -type f \( -name "*.sh" -o -name "*.md" -o -name "*.json" -o -name "*.go" -o -name "*.fastapi" -o -name "*.mht" \) 2>/dev/null | \
        sort > "$SKILLS_DIR/ranger_files.txt"
        ok "Found $(wc -l < "$SKILLS_DIR/ranger_files.txt") files via native find"
    fi
}

# oRiKAL agent: Read/create files and extract skills
orikal_scan() {
    log "oRiKAL validator scanning agents..."
    
    local agent_count=0
    local skills_list=()
    
    # Ensure agents directory exists
    if [[ ! -d "$AGENTS_DIR" ]]; then
        warn "Agents directory missing, creating structure..."
        mkdir -p "$AGENTS_DIR"
        
        # Create placeholder agent.sh files for all 25 planets
        for agent in Mercury Venus Earth Mars Jupiter Saturn Uranus Neptune Pluto Ceres Eris Makemake Haumea Sedna Quaoar Orcus Varuna Ixion Chaos Huya Salacia Altjira Varda Gonggong Deimos; do
            cat > "$AGENTS_DIR/${agent,,}-agent.sh" << AGENTEOF
#!/data/data/com.termux/files/usr/bin/env bash
# $agent Agent - Auto-generated by oRiKAL
AGENT_NAME="$agent"
AGENT_CLUSTER="UNASSIGNED"
AGENT_SKILLS=()

execute() {
    echo "[\$AGENT_NAME] Ready for task: \$*"
}

register_skill() {
    AGENT_SKILLS+=("\$1")
    echo "[\$AGENT_NAME] Registered skill: \$1"
}

# Default skills
register_skill "file_read"
register_skill "file_write"
register_skill "command_exec"
AGENTEOF
            chmod +x "$AGENTS_DIR/${agent,,}-agent.sh"
            ((agent_count++))
        done
        ok "Created $agent_count placeholder agent scripts"
    fi
    
    # Scan existing agent.sh files
    for agent_file in "$AGENTS_DIR"/*.sh; do
        [[ -f "$agent_file" ]] || continue
        
        local name=$(basename "$agent_file" .sh)
        log "oRiKAL reading: $name"
        
        # Extract skills from file (look for register_skill, functions, or comments)
        local file_skills=()
        while IFS= read -r line; do
            if [[ "$line" =~ register_skill\ \"([^\"]+)\" ]]; then
                file_skills+=("${BASH_REMATCH[1]}")
            elif [[ "$line" =~ ^[a-zA-Z_]+\(\)\ \{ ]]; then
                local func_name="${line%%(*}"
                [[ "$func_name" != "execute" && "$func_name" != "register_skill" ]] && file_skills+=("$func_name")
            fi
        done < "$agent_file"
        
        # If no skills found, oRiKAL creates default skills
        if [[ ${#file_skills[@]} -eq 0 ]]; then
            log "oRiKAL injecting default skills into $name"
            file_skills=("file_read" "file_write" "command_exec" "status_check")
            
            # Append skills to agent file
            cat >> "$agent_file" << INJECTEOF

# oRiKAL injected skills
register_skill "file_read"
register_skill "file_write"
register_skill "command_exec"
register_skill "status_check"
INJECTEOF
        fi
        
        # Store skills in JSON format
        local skills_json=$(printf '"%s",' "${file_skills[@]}")
        skills_json="[${skills_json%,}]"
        
        echo "{\"agent\":\"$name\",\"file\":\"$agent_file\",\"skills\":$skills_json}" >> "$SKILLS_DIR/agent_skills.ndjson"
        ((agent_count++))
    done
    
    ok "oRiKAL processed $agent_count agents"
}

# Generate complete systems.skills manifest
generate_manifest() {
    log "Generating systems.skills manifest..."
    
    cat > "$SKILLS_DIR/system.skills.manifest" << MANIFESTEOF
================================================================================
C25 CONSTELLATION25 - SYSTEM.SKILLS MANIFEST
Generated: $(date)
================================================================================

AGENT REGISTRY:
---------------
MANIFESTEOF
    
    # List all agents with their skills
    if [[ -f "$SKILLS_DIR/agent_skills.ndjson" ]]; then
        while IFS= read -r line; do
            local agent=$(echo "$line" | jq -r '.agent // "unknown"')
            local skills=$(echo "$line" | jq -r '.skills | join(", ") // "none"')
            echo "  • $agent → [$skills]" >> "$SKILLS_DIR/system.skills.manifest"
        done < "$SKILLS_DIR/agent_skills.ndjson"
    fi
    
    cat >> "$SKILLS_DIR/system.skills.manifest" << MANIFESTEOF

TERMUX HISTORY COMMANDS:
------------------------
$(head -50 "$SKILLS_DIR/history_commands.txt" 2>/dev/null || echo "  No history available")

DISCOVERED FILES:
-----------------
$(cat "$SKILLS_DIR/ranger_files.txt" 2>/dev/null | head -50 || echo "  No files discovered")

SKILL EXECUTION PROTOCOL:
-------------------------
All agents execute commands through their registered shell skills:
  1. Intent parsed by Haumea (Neo)
  2. Translated to bash by Sedna (Morpheus)
  3. Validated by Quaoar (oRiKAL)
  4. Coordinated by Orcus (Swarm)
  5. Executed via agent-specific skill functions

================================================================================
MANIFESTEOF
    
    ok "Manifest saved to $SKILLS_DIR/system.skills.manifest"
}

# Main execution
main() {
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}       C25 SYSTEM.SKILLS - MASTER SKILL REGISTRY      ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo
    
    init_registry
    scan_termux_history
    scan_with_ranger
    orikal_scan
    generate_manifest
    
    echo
    ok "Systems.skills complete! View manifest: $SKILLS_DIR/system.skills.manifest"
    echo
    log "To execute skills: source $SKILLS_DIR/system.skills && run_agent <name> <skill> <args>"
}

# Run if executed directly
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main "$@"
